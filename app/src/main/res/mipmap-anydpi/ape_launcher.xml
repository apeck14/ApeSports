<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="48dp"/>
            <corners android:radius="10dp"/>
            <gradient android:angle="270" android:startColor="@color/brand_background_top" android:endColor="@color/brand_background_bottom"/>
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <bitmap android:src="@drawable/ape_logo" android:gravity="fill" android:filter="true"/>
    </item>
</layer-list>
